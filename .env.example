# MCHPAI Wallet Intelligence System — environment template.
# Copy to .env and adjust. The intelligence core needs none of these; they
# configure the deployed infrastructure adapters in wis.infra.

# PostgreSQL (system of record)
WIS_PG_HOST=localhost
WIS_PG_PORT=5432
WIS_PG_USER=wis
WIS_PG_PASSWORD=wis
WIS_PG_DB=wis

# ClickHouse (analytical store)
WIS_CLICKHOUSE_HOST=localhost
WIS_CLICKHOUSE_PORT=8123

# Redis (hot online cache)
WIS_REDIS_URL=redis://localhost:6379/0

# Neo4j (relationship graph)
WIS_NEO4J_URI=bolt://localhost:7687
WIS_NEO4J_AUTH=neo4j/wisgraphpw

# NATS JetStream (event backbone)
WIS_NATS_URL=nats://localhost:4222
WIS_EVENT_STREAM=wis-events

# MinIO (object store / replay archive)
WIS_MINIO_ENDPOINT=localhost:9000
WIS_MINIO_USER=wis
WIS_MINIO_PASSWORD=wisminiopw
WIS_MINIO_BUCKET=wis-replay
