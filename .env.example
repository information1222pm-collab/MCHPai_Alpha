# ============================================================================
# MCHPAI — environment configuration. Copy to .env and fill in secrets.
# Nothing in here is loaded automatically by source; services read via
# mchpai_common.config.Settings (pydantic-settings) or std env.
# ============================================================================

# ---- Runtime ----------------------------------------------------------------
MCHPAI_ENV=local                     # local | staging | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                      # json | console

# ---- Event bus (NATS JetStream) --------------------------------------------
NATS_URL=nats://nats:4222
NATS_STREAM_PREFIX=mchpai
NATS_DURABLE_PREFIX=mchpai

# ---- PostgreSQL (truth DB) --------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mchpai
POSTGRES_USER=mchpai
POSTGRES_PASSWORD=mchpai_dev_pw
POSTGRES_URL=postgresql://mchpai:mchpai_dev_pw@postgres:5432/mchpai

# ---- ClickHouse (time-series / analytics) ----------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=mchpai
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ---- Neo4j (graph intelligence) --------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mchpai_dev_pw

# ---- Redis (hot cache) ------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- MinIO (feature store / model artifacts, S3-compatible) ----------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=mchpai
MINIO_SECRET_KEY=mchpai_dev_secret
MINIO_BUCKET_FEATURES=features
MINIO_BUCKET_MODELS=models
MINIO_SECURE=false

# ---- Data providers ---------------------------------------------------------
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
BIRDEYE_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Yellowstone gRPC (Geyser)
YELLOWSTONE_ENDPOINT=
YELLOWSTONE_X_TOKEN=

# ---- Execution / Jito -------------------------------------------------------
EXECUTION_MODE=paper                 # paper | live
SOLANA_RPC_URLS=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=100000
WALLET_KEYPAIR_PATH=/run/secrets/hot_wallet.json   # never commit this

# ---- Risk controls ----------------------------------------------------------
BANKROLL_SOL=10.0
KELLY_FRACTION=0.25
MIN_TICKET_SOL=0.05
MAX_TICKET_SOL=2.0
MAX_TOKEN_EXPOSURE_SOL=4.0
DAILY_LOSS_LIMIT_SOL=3.0

# ---- Prediction thresholds --------------------------------------------------
TAU_BUY_PROBABILITY=0.65
TAU_EXPECTED_VALUE_BPS=150
TAU_RISK_SCORE_MAX=55

# ---- Alerts -----------------------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_SMTP_URL=

# ---- Observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_PORT=9000
