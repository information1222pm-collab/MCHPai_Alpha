| =====================================================================
|  RogueBurn.mac  -  one-key Rogue burn  (Shattering of Ro, Lv 130)
| ---------------------------------------------------------------------
|  Fires your full burn stack in the researched, current burn order,
|  once, then ends.   Bind it:   /bind LeftAlt+1 /mac RogueBurn
|
|  BURN ORDER (current Rogue consensus, SoR):
|    1. Rogue's Fury           (AA - signature accuracy/crit/min-dmg buff)
|    2. Third Spire of the Rake(AA - crit buff; lead so everything benefits)
|    3. Lead offensive DISC    (Frenzied Stabbing OR Twisted Chance - see note)
|    4. Ligament Slice         (AA - debuff + damage; also your fight opener)
|    5. Rake's Rampage + the rest of your ready damage AAs
|    6. Clicky burn item(s)
|    ...with Backstab + auto-attack hammering throughout.
|
|  NOTE ON DISCS: Frenzied Stabbing Discipline greatly shortens Backstab's
|  reuse; Twisted Chance Discipline boosts crit + to-hit and pairs well with
|  Rogue's Fury. They occupy the disc timer, so you run ONE as the lead and
|  RogueAssist.mac cycles the hand-off chain (Executioner's -> Knifeplay ->
|  Razor's Edge -> Arcworker) as each fades.
|
|  >>> RUN ExportAbilities.mac ONCE to get YOUR exact owned names + IDs,
|      then paste them into the CONFIGURE ME block below. Names use the
|      BASE name (no rank numeral) - MQ2 matches the highest rank you own.
| =====================================================================

Sub Main
    | ---------------------- CONFIGURE ME ----------------------------
    | --- Activated damage AAs (these STACK - fire them all) ---
    /declare AA_Fury        string local Rogue's Fury
    /declare AA_Spire       string local Third Spire of the Rake
    /declare AA_Ligament    string local Ligament Slice
    /declare AA_Rampage     string local Rake's Rampage
    /declare AA_FocRampage  string local Focused Rake's Rampage
    /declare AA_Intensity   string local Intensity of the Resolute
    | --- These vary by expansion/owned - ExportAbilities.mac confirms them.
    | --- Leave a wrong name and it's simply skipped (nothing breaks). ---
    /declare AA_Extra1      string local Twisted Shank
    /declare AA_Extra2      string local Banestrike
    /declare AA_Extra3      string local Absorbing Agent

    | --- Lead offensive DISCIPLINE (run ONE). Pick your preference: ---
    | --- "Frenzied Stabbing Discipline" or "Twisted Chance Discipline" ---
    /declare DISC_Lead      string local Frenzied Stabbing Discipline

    | --- Optional clicky burn item(s). Blank = skip. ---
    /declare ITEM_Clicky    string local

    /declare StickBehind    bool   local TRUE
    | ----------------------- END CONFIG -----------------------------

    /if (!${Target.ID} || ${Target.Type.Equal[PC]}) {
        /echo \ar[RogueBurn] No valid mob target - target something first.
        /return
    }
    /echo \ag[RogueBurn] >>> BURNING <<<  \ay${Target.CleanName}

    /if (${StickBehind} && ${Plugin[MQ2MoveUtils].Name.Length}) /stick 12 behind
    /attack on

    /call FireAA  "${AA_Fury}"
    /call FireAA  "${AA_Spire}"
    /call FireDisc "${DISC_Lead}"
    /call FireAA  "${AA_Ligament}"
    /call FireAA  "${AA_Rampage}"
    /call FireAA  "${AA_FocRampage}"
    /call FireAA  "${AA_Intensity}"
    /call FireAA  "${AA_Extra1}"
    /call FireAA  "${AA_Extra2}"
    /call FireAA  "${AA_Extra3}"

    /if (${ITEM_Clicky.Length} && ${FindItem[=${ITEM_Clicky}].ID}) {
        /useitem "${ITEM_Clicky}"
        /delay 5
    }

    /call Backstab
    /echo \ag[RogueBurn] Burn dumped. Keep RogueAssist running for sustained DPS.
/return

| --------------------------------------------------------------------
Sub FireAA(string Name)
    /if (!${Name.Length}) /return
    /if (${Me.AltAbility[${Name}].ID} && ${Me.AltAbilityReady[${Name}]}) {
        /alt activate ${Me.AltAbility[${Name}].ID}
        /echo \ao  AA: \aw${Name}
        /delay 5
    }
/return

| --------------------------------------------------------------------
Sub FireDisc(string Name)
    /if (!${Name.Length}) /return
    /if (${Me.CombatAbility[${Name}].ID} && ${Me.CombatAbilityReady[${Name}]}) {
        /disc ${Name}
        /echo \ao  DISC: \aw${Name}
        /delay 5
    }
/return

| --------------------------------------------------------------------
Sub Backstab
    /if (${Me.AbilityReady[Backstab]}) {
        /doability Backstab
        /delay 3
    }
/return
